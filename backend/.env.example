# FSense Backend Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - OpenAI Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Your OpenAI API key (REQUIRED)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - Database Configuration (Supabase)
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string from Supabase
# Get from: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase project URL and service key (for Storage)
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Application Settings
# ═══════════════════════════════════════════════════════════════════════════════

# Environment name (local, staging, production)
FSENSE_ENV=local

# Backend version
FSENSE_VERSION=v0.0.1

# Default region for cultural context (us, eu, asia, etc.)
DEFAULT_REGION=us

# Maximum flower candidates to consider
MAX_CANDIDATES=5

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Debug Settings
# ═══════════════════════════════════════════════════════════════════════════════

# Enable debug mode (true/false)
DEBUG_MODE=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Flower Search Providers
# ═══════════════════════════════════════════════════════════════════════════════

# Yandex Cloud Search API (for Russia)
# Get keys from: https://console.cloud.yandex.ru/
YANDEX_CLOUD_API_KEY=your-yandex-api-key
YANDEX_CLOUD_FOLDER_ID=your-folder-id

# Florist One API (for US/Canada)
# Get keys from: https://florist.one/api/
# Uses HTTP Basic Auth: API Key as username, Password as password
FLORIST_ONE_API_KEY=your-api-key
FLORIST_ONE_API_PASSWORD=your-api-password
