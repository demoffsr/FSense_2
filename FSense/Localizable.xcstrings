    "Your location is used to find flower shops near you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Standort wird verwendet, um Blumenläden in Ihrer Nähe zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación se usa para encontrar floristerías cercanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre localisation sert à trouver des fleuristes près de vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お近くの花屋を見つけるために位置情報を使用します。"
