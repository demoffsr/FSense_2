    "NSCameraUsageDescription": {
      "comment": "Permission message shown when the app requests camera access",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense needs camera access to scan and identify flowers"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense нужен доступ к камере для сканирования и распознавания цветов"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense necesita acceso a la cámara para escanear e identificar flores"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense benötigt Kamerazugriff, um Blumen zu scannen und zu identifizieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense a besoin d'accéder à l'appareil photo pour scanner et identifier les fleurs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense需要使用相机来扫描和识别花卉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FSenseは花をスキャンして識別するためにカメラへのアクセスが必要です"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Permission message shown when the app requests photo library access",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense needs access to your photos to attach flower images"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense нужен доступ к фото для прикрепления изображений цветов"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense necesita acceso a tus fotos para adjuntar imágenes de flores"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense benötigt Zugriff auf Ihre Fotos, um Blumenbilder anzuhängen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense a besoin d'accéder à vos photos pour joindre des images de fleurs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FSense需要访问您的照片以附加花卉图片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FSenseは花の画像を添付するために写真へのアクセスが必要です"
          }
        }
      }
    }
  },
  "version": "1.0"
}